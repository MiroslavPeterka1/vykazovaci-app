# Konfigurace Firebase projektu (Project settings → Your apps → Web app).
# Zkopíruj do .env.local a doplň hodnoty. .env* je mimo git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = napojit se na lokální emulátory místo ostrého projektu
VITE_USE_EMULATORS=false
