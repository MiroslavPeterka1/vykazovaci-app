rules_version = '2';

// Etapa 0: jen vlastnictví dat. Tvarová validace (povinná pole, konec > začátek,
// konzistence running/durationMinutes, zákaz zápisu do součtů) přijde v etapě 6.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
